# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=budgeted

# JWT (change in production)
JWT_SECRET=change-me-in-production

# Budget API
BUDGET_API_PORT=3001
# Optional: Vite dev proxy target for /api (default http://localhost:3001)
# BUDGET_API_PROXY_TARGET=http://localhost:3001

# Gemini: AI spending insights in GroupView (optional)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Receipt OCR — local Ollama (default) or Google Gemini
# Ollama: https://ollama.com — use a vision model for receipts (not plain llama3.1)
RECEIPT_OCR_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava

# AI spending insights (GroupView) — text model via Ollama or Gemini
AI_INSIGHTS_PROVIDER=ollama
OLLAMA_TEXT_MODEL=llama3.1:8b
# GEMINI_INSIGHTS_MODEL=gemini-2.0-flash  # when AI_INSIGHTS_PROVIDER=gemini

# PDF expense import — AI categorization before DB (uses AI_INSIGHTS_PROVIDER / OLLAMA_TEXT_MODEL)
EXPENSE_IMPORT_LLM_ENRICH=true

# Loan schedule import — photo/PDF amortization table (uses RECEIPT_OCR_PROVIDER / OLLAMA_VISION_MODEL)
# Same Ollama vision model as receipt OCR for Cal / bank loan tables
# EXPENSE_IMPORT_LLM_ALWAYS=true   # run gap-fill LLM even when rule parser looks complete
# EXPENSE_IMPORT_LLM_ENRICH=false  # disable AI reconcile pass

# Phone barcode camera over Wi‑Fi: enable self-signed HTTPS (accept cert on phone)
# VITE_DEV_HTTPS=true

# Supermarket price sync (optional — Docker NOT required)
# Option A: Python venv in project (no admin, no Docker)
#   npm run scraper:setup      # once: .venv + pip + playwright
#   npm run scraper:download   # downloads XML to SUPERMARKET_DUMPS_DIR
#   npm run sync:prices        # imports into MySQL
#   npm run scraper:sync       # download + sync
# Option B: Docker
#   npm run scraper:run && npm run sync:prices
# Demo data (no scraper): already seeded on first migrate, or npm run seed:products
SUPERMARKET_DUMPS_DIR=./data/supermarket-dumps
ENABLED_SCRAPERS=SHUFERSAL,RAMI_LEVY,HAZI_HINAM
SCRAPER_LIMIT=3

# Automatic daily price sync (runs inside npm run dev:server)
# Requires scraper venv: npm run scraper:setup
PRICE_SYNC_ENABLED=true
PRICE_SYNC_AT_HOUR=3
PRICE_SYNC_INTERVAL_HOURS=24
PRICE_SYNC_ON_START=true


