# ApexStream Auth (email/password end-user auth)
VITE_APEXSTREAM_CONTROL_PLANE_URL=http://localhost:8080
VITE_APEXSTREAM_APP_ID=
VITE_APEXSTREAM_PUBLISHABLE_KEY=

# ApexStream WebSocket gateway + Document DB
VITE_APEXSTREAM_WS_URL=ws://localhost:8081/v1/ws
# Read/subscribe key (pk_live_…) — safe in the browser
VITE_APEXSTREAM_API_KEY=
# Optional write key (sk_live_…) for Document DB mutations from the browser.
# In production prefer a backend with sk_live_; see apexstream/examples/document-db
VITE_APEXSTREAM_SECRET_KEY=
VITE_APEXSTREAM_CHANNEL=budgeted:live
VITE_APEXSTREAM_ALLOW_INSECURE=1

# Gemini AI insights (optional)
GEMINI_API_KEY=
